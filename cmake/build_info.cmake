# Writes the build stamp header (build time, short git commit) for core/build_info.cpp.
# Run by the always-out-of-date `sr2mods_build_info` target on every build:
#   cmake -DOUT=<header> -DSRC=<source dir> -P build_info.cmake
# The header is only rewritten when its text changes, so a rebuild in the same minute
# (same commit) does not recompile or relink anything.

string(TIMESTAMP SR2_TIME_ISO "%Y-%m-%dT%H:%M")   # local time of the build machine
string(TIMESTAMP SR2_TIME_SHORT "%d/%m %H:%M")

set(SR2_COMMIT "")
find_program(SR2_GIT git)
if(SR2_GIT)
  execute_process(COMMAND "${SR2_GIT}" rev-parse --short HEAD
    WORKING_DIRECTORY "${SRC}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(rc EQUAL 0 AND out)
    set(SR2_COMMIT "${out}")
    execute_process(COMMAND "${SR2_GIT}" status --porcelain --untracked-files=no
      WORKING_DIRECTORY "${SRC}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(rc EQUAL 0 AND out)
      string(APPEND SR2_COMMIT "-dirty")
    endif()
  endif()
endif()

set(text "// Generated by cmake/build_info.cmake on every build - do not edit.
#pragma once
#define SR2MODS_BUILD_TIME \"${SR2_TIME_ISO}\"
#define SR2MODS_BUILD_TIME_SHORT \"${SR2_TIME_SHORT}\"
#define SR2MODS_BUILD_COMMIT \"${SR2_COMMIT}\"
")

set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
